{
  "name": "school-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --fix",
    "format": "prettier src --write",
    "test": "jest",
    "db:generate": "npx prisma generate --schema=packages/schema/prisma.schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=packages/schema/prisma.schema.prisma",
    "db:seed": "npx tsx packages/schema/seed.ts",
    "db:studio": "npx prisma studio --schema=packages/schema/prisma.schema.prisma"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^1.0.0",
    "lucide-react": "^0.263.1",
    "next-auth": "^4.24.0",
    "bcryptjs": "^2.4.0",
    "date-fns": "^2.30.0",
    "zod": "^3.22.0",
    "react-hook-form": "^7.47.0",
    "react-query": "^3.39.3",
    "zustand": "^4.4.1",
    "@prisma/client": "^5.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "pg": "^8.14.0",
    "pino": "^8.19.0"
