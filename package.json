    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "typescript": "^5.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0",
    "prisma": "^5.0.0",
    "@testing-library/react": "^14.0.2",
    "@testing-library/jest-dom": "^5.16.5"
  }
